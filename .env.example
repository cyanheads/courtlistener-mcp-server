# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max inbound request body size in bytes (default: 1 MiB). Set to 0 to disable.

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # stateless | stateful | auto (default: auto, which resolves to stateful).
                                    # This server ships stateless — no handler asks the client for input
                                    # mid-call — and declares it in src/index.ts via createApp({ sessionMode }).

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# LOG_TOOL_FAILURE_PAYLOADS=false   # Log redacted failed-call inputs and results (opt-in)
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384  # Per-payload log size cap in bytes

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # Base for /v1/traces and /v1/metrics; unset exports neither
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Optional traces endpoint override
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Optional metrics endpoint override
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Explicit opt-in for redacted OTLP logs; the base never enables it

# ── Server-specific ──────────────────────────────────────────────────
COURTLISTENER_API_TOKEN=            # Required. Free token from https://www.courtlistener.com/sign-in/
# COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4  # Override the API base URL
# COURTLISTENER_RATE_LIMIT_PER_MINUTE=5   # Requests this server starts per rolling minute (default: 5)
# COURTLISTENER_RATE_LIMIT_PER_HOUR=50    # Requests this server starts per rolling hour (default: 50)
                                    # Defaults follow CourtListener's published free tier. Raise them to match a
                                    # higher token tier — leaving them low queues requests you are allowed to send.
